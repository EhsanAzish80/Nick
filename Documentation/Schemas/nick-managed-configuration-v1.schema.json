{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nick.3nsofts.com/schemas/managed-configuration-v1.schema.json",
  "title": "Nick Managed Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "logLevel", "retentionDays", "exportFormats",
    "captureDurationSeconds", "sanitizeExports", "showUserInterface"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "organizationName": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "logLevel": { "enum": ["error", "warning", "info", "debug"] },
    "retentionDays": { "type": "integer", "minimum": 1, "maximum": 90 },
    "exportDirectory": { "type": ["string", "null"], "pattern": "^/", "maxLength": 1024 },
    "exportFormats": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["json", "jsonLines", "keyValue", "cef", "markdown"] }
    },
    "captureDurationSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
    "sanitizeExports": { "const": true },
    "showUserInterface": { "type": "boolean" }
  }
}
