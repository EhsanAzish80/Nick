{
  "version": "1.0",
  "description": "Feature schema for Nick behavioral threat scoring model. 40-dimensional input vector.",
  "features": [
    {"index": 0,  "name": "process_is_unsigned",              "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Binary has no valid code signature"},
    {"index": 1,  "name": "process_is_adhoc_signed",          "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Signed but no team identifier"},
    {"index": 2,  "name": "process_in_tmp",                   "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Executing from /tmp or /var/tmp"},
    {"index": 3,  "name": "process_in_hidden_dir",            "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Path contains a hidden directory"},
    {"index": 4,  "name": "process_is_shell",                 "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Process is bash/zsh/sh/python/ruby/perl"},
    {"index": 5,  "name": "process_parent_is_gui_app",        "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Parent is a .app bundle process"},
    {"index": 6,  "name": "process_parent_is_terminal",       "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Parent is Terminal/iTerm/Warp"},
    {"index": 7,  "name": "process_parent_chain_depth",       "type": "int",   "range": [0, 10],  "source": "ProcessMonitor",       "description": "Depth of parent-child chain"},
    {"index": 8,  "name": "process_age_seconds",              "type": "float", "range": [0, null],"source": "ProcessMonitor",       "description": "Seconds since process started"},
    {"index": 9,  "name": "process_is_lolbin",                "type": "bool",  "range": [0, 1],   "source": "ProcessMonitor",       "description": "Known living-off-the-land binary"},
    {"index": 10, "name": "net_has_outbound_connection",      "type": "bool",  "range": [0, 1],   "source": "NetworkAnalyzer",      "description": "Process has ESTABLISHED outbound TCP"},
    {"index": 11, "name": "net_remote_is_raw_ip",             "type": "bool",  "range": [0, 1],   "source": "NetworkAnalyzer",      "description": "Connected to IP with no DNS resolution"},
    {"index": 12, "name": "net_remote_port",                  "type": "int",   "range": [0, 65535],"source": "NetworkAnalyzer",     "description": "Remote port number"},
    {"index": 13, "name": "net_remote_port_is_common",        "type": "bool",  "range": [0, 1],   "source": "NetworkAnalyzer",      "description": "Port is 80, 443, 22, 53"},
    {"index": 14, "name": "net_is_listening",                 "type": "bool",  "range": [0, 1],   "source": "NetworkAnalyzer",      "description": "Process has listening socket"},
    {"index": 15, "name": "net_connection_count",             "type": "int",   "range": [0, null],"source": "NetworkAnalyzer",      "description": "Number of active connections"},
    {"index": 16, "name": "net_uses_uncommon_port",           "type": "bool",  "range": [0, 1],   "source": "NetworkAnalyzer",      "description": "Port not in common service list"},
    {"index": 17, "name": "fs_file_in_tmp",                   "type": "bool",  "range": [0, 1],   "source": "FileSystemWatcher",    "description": "Related file is in temp directory"},
    {"index": 18, "name": "fs_file_entropy",                  "type": "float", "range": [0, 8],   "source": "HeuristicAnalyzer",    "description": "Shannon entropy of file"},
    {"index": 19, "name": "fs_file_entropy_is_high",          "type": "bool",  "range": [0, 1],   "source": "HeuristicAnalyzer",    "description": "Entropy > 7.5"},
    {"index": 20, "name": "fs_file_is_macho",                 "type": "bool",  "range": [0, 1],   "source": "HeuristicAnalyzer",    "description": "File is a Mach-O binary"},
    {"index": 21, "name": "fs_file_has_embedded_urls",        "type": "bool",  "range": [0, 1],   "source": "HeuristicAnalyzer",    "description": "Contains URL/IP strings"},
    {"index": 22, "name": "fs_file_has_embedded_base64",      "type": "bool",  "range": [0, 1],   "source": "HeuristicAnalyzer",    "description": "Contains base64-encoded blobs"},
    {"index": 23, "name": "fs_rapid_creation_detected",       "type": "bool",  "range": [0, 1],   "source": "FileSystemWatcher",    "description": "10+ files in 5s in temp dirs"},
    {"index": 24, "name": "persist_new_launchagent",          "type": "bool",  "range": [0, 1],   "source": "PersistenceWatcher",   "description": "New item in LaunchAgents dir"},
    {"index": 25, "name": "persist_new_launchdaemon",         "type": "bool",  "range": [0, 1],   "source": "PersistenceWatcher",   "description": "New item in LaunchDaemons dir"},
    {"index": 26, "name": "persist_new_cronjob",              "type": "bool",  "range": [0, 1],   "source": "PersistenceWatcher",   "description": "New cron entry"},
    {"index": 27, "name": "persist_executable_unsigned",      "type": "bool",  "range": [0, 1],   "source": "PersistenceWatcher",   "description": "Persistence target is unsigned"},
    {"index": 28, "name": "persist_executable_missing",       "type": "bool",  "range": [0, 1],   "source": "PersistenceWatcher",   "description": "Persistence points to nonexistent file"},
    {"index": 29, "name": "yara_match_count",                 "type": "int",   "range": [0, null],"source": "YARAEngine",           "description": "Number of YARA rule matches"},
    {"index": 30, "name": "yara_max_severity",                "type": "int",   "range": [0, 4],   "source": "YARAEngine",           "description": "Highest severity among matched rules"},
    {"index": 31, "name": "audit_sip_disabled",               "type": "bool",  "range": [0, 1],   "source": "SystemAuditor",        "description": "SIP is not enabled"},
    {"index": 32, "name": "audit_filevault_disabled",         "type": "bool",  "range": [0, 1],   "source": "SystemAuditor",        "description": "FileVault is off"},
    {"index": 33, "name": "audit_gatekeeper_disabled",        "type": "bool",  "range": [0, 1],   "source": "SystemAuditor",        "description": "Gatekeeper is disabled"},
    {"index": 34, "name": "audit_firewall_disabled",          "type": "bool",  "range": [0, 1],   "source": "SystemAuditor",        "description": "Application Firewall is off"},
    {"index": 35, "name": "temporal_time_since_file_creation","type": "float", "range": [0, null],"source": "Temporal",             "description": "Seconds between file creation and process start"},
    {"index": 36, "name": "temporal_time_since_net_connection","type": "float","range": [0, null],"source": "Temporal",             "description": "Seconds between process start and first connection"},
    {"index": 37, "name": "temporal_signals_in_window",       "type": "int",   "range": [0, null],"source": "ThreatCorrelator",     "description": "Total signals from all monitors in 30s window"},
    {"index": 38, "name": "temporal_unique_monitors_firing",  "type": "int",   "range": [0, 7],   "source": "ThreatCorrelator",     "description": "Number of distinct monitors with signals in window"},
    {"index": 39, "name": "temporal_severity_escalation",     "type": "bool",  "range": [0, 1],   "source": "ThreatCorrelator",     "description": "Severity increased within the window"}
  ],
  "labels": ["benign", "suspicious", "malicious"],
  "label_column": "label",
  "model": {
    "algorithm": "GradientBoostingClassifier",
    "framework": "scikit-learn",
    "coreml_output": "ThreatScorer.mlmodel",
    "output_feature": "threatProbability",
    "performance_targets": {
      "precision": 0.90,
      "recall": 0.85,
      "inference_ms": 5,
      "model_size_mb": 1
    }
  }
}
